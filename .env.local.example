# ============================================================================
# IENN Gastos App — variables de entorno
# Copiar a .env.local (nunca commitear .env.local).
#
# Dónde encontrarlas: Supabase Dashboard > Project Settings > API
# ============================================================================

# --- Públicas (se exponen al browser — el acceso real lo controla RLS) ------

# URL del proyecto Supabase, ej. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima / publishable. Es pública por diseño.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Privadas (solo servidor — NUNCA con prefijo NEXT_PUBLIC_) --------------

# service_role key: bypassea RLS. Solo para Route Handlers / Server Actions
# que necesiten operaciones administrativas (ej. ingesta masiva).
# Dejar vacía si todavía no se usa.
SUPABASE_SERVICE_ROLE_KEY=
